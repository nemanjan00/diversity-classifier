{
	"name": "@nemanjan00/diversity-streamer",
	"version": "0.1.0",
	"description": "MCP server that lets an AI agent watch log streams cheaply: teach it templates, get only unknown lines, metrics and alarms",
	"main": "src/engine/index.js",
	"bin": {
		"diversity-streamer": "bin/mcp.js",
		"diversity-classifier": "bin/mcp.js"
	},
	"license": "MIT",
	"author": "Nemanja Nedeljkovic <nemanjan00@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nemanjan00/diversity-classifier.git"
	},
	"keywords": [
		"mcp",
		"logs",
		"log-analysis",
		"classifier",
		"ai",
		"claude"
	],
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@nemanjan00/qrp": "^0.13.0",
		"@nemanjan00/qrp-shadcdn": "^0.3.0"
	},
	"devDependencies": {
		"@babel/core": "^8.0.7",
		"@babel/eslint-parser": "^8.0.7",
		"eslint": "8",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"lint-staged": "^17.6.0",
		"nodemon": "^3.1.14"
	},
	"scripts": {
		"mcp": "node bin/mcp.js",
		"mcp-watch": "nodemon -q bin/mcp.js",
		"lint": "eslint src/ bin/",
		"test": "jest",
		"test:watch": "jest --watch",
		"prepare": "husky"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"bin",
		"src",
		"!src/**/__tests__",
		"README.md",
		"SPEC.md",
		"LICENSE"
	],
	"jest": {
		"testEnvironment": "node",
		"forceExit": true,
		"testPathIgnorePatterns": [
			"/node_modules/",
			"/src/web/public/"
		]
	},
	"lint-staged": {
		"*.js": "eslint --fix"
	},
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/nemanjan00/diversity-classifier#readme",
	"bugs": {
		"url": "https://github.com/nemanjan00/diversity-classifier/issues"
	}
}
